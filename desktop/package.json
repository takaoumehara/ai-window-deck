{
  "name": "ai-window-deck-desktop",
  "productName": "AI Window Deck",
  "private": true,
  "version": "0.1.0",
  "description": "AI Window Deck as a desktop app: registered windows split inside one window.",
  "author": "Takao Umehara",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on tcp:5174 && cross-env DECK_DEV_URL=http://localhost:5174 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.takaoumehara.aiwindowdeck",
    "productName": "AI Window Deck",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}

{
  "manifest_version": 3,
  "name": "AI Window Deck",
  "version": "1.6.2",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "tabs",
    "tabGroups",
    "windows",
    "storage",
    "system.display"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "dist/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "dist/index.html",
    "default_title": "AI Window Deck",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-spotlight": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Switch between the tile and the size you chose"
    },
    "restore-home": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "Put this window back where it started"
    },
    "tile-windows": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Arrange the windows into a grid"
    },
    "toggle-fullscreen": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Full screen, or back to the size it was"
    },
    "undo-layout": {
      "description": "Undo the last arrangement"
    },
    "focus-next": {
      "description": "Focus the next window"
    },
    "focus-previous": {
      "description": "Focus the previous window"
    },
    "focus-tile-1": {
      "description": "Focus window 1"
    },
    "focus-tile-2": {
      "description": "Focus window 2"
    },
    "focus-tile-3": {
      "description": "Focus window 3"
    },
    "focus-tile-4": {
      "description": "Focus window 4"
    },
    "focus-tile-5": {
      "description": "Focus window 5"
    },
    "focus-tile-6": {
      "description": "Focus window 6"
    },
    "focus-tile-7": {
      "description": "Focus window 7"
    },
    "focus-tile-8": {
      "description": "Focus window 8"
    }
  }
}
